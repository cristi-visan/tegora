# Template for the .env file on the staging server. Fill in, upload as .env
# to the site's root folder (cPanel File Manager). Never commit the real file.

APP_NAME="Tegora"
APP_ENV=production
APP_DEBUG=false
# 32 random bytes, base64: php -r "echo 'base64:'.base64_encode(random_bytes(32));"
APP_KEY=
APP_URL=https://tegora-staging.codefor.ge
APP_LOCALE=ro

ACTIVE_THEME=tegora
BACKEND_URI=/admin
CMS_ROUTE_CACHE=true
CMS_ASSET_CACHE=true
CMS_ASSET_MINIFY=true
CMS_SAFE_MODE=true
LINK_POLICY=detect
DEFAULT_FILE_MASK=644
DEFAULT_FOLDER_MASK=755

# Keeps search engines out. Set to false only on the live site.
SITE_NOINDEX=true

# Long random string; must equal the DEPLOY_TOKEN GitHub secret.
# php -r "echo bin2hex(random_bytes(32));"
DEPLOY_TOKEN=

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

LOG_CHANNEL=single
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# With MAIL_MAILER=log, requests are saved and the email only goes to the log.
# For real sending: MAIL_MAILER=smtp and fill in the mailbox details.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=contact@tegora.ro
MAIL_FROM_NAME="Tegora"
